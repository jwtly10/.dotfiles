auto-update-channel = tip
auto-update = download
window-inherit-working-directory = true

# ui
font-size = 17

# Dark blue
# background = #282a2c
# font-family=FiraCode Nerd Font
# font-family=Berkeley Mono
# config-file = ?auto/theme.ghostty
# window-padding-x = 30
# window-padding-x = 5
# window-padding-y = 5
# macos-titlebar-style = native
# Black
# background = #000000
# Off black
# background = #191919
mouse-hide-while-typing = true

keybind = cmd+enter=unbind
keybind = ctrl+enter=unbind
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+j=goto_split:down
keybind = super+k=goto_split:up

keybind = super+right=resize_split:right,30
keybind = super+left=resize_split:left,30
keybind = super+down=resize_split:down,30
keybind = super+up=resize_split:up,30

#Increase to 100MB
scrollback-limit=100000000
