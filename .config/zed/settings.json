{
  "auto_update": false,
  "buffer_font_weight": 400.0,
  "show_edit_predictions": false,
  "gutter": {
    "folds": true,
    "runnables": true
  },
  "diagnostics_max_severity": "all",
  "cli_default_open_behavior": "new_window",
  "disable_ai": false,
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "provider": "copilot",
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "FiraCode Nerd Font",
  // "buffer_font_family": "Berkeley Mono",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
    "github-copilot": {
      "type": "registry",
    },
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
    "use_modifier_to_send": false,
  },
  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },
  "unnecessary_code_fade": 0.3,
  "agent_ui_font_size": 20.0,
  "buffer_line_height": "comfortable",
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "load_direnv": "direct",
  "format_on_save": "off",
  "preview_tabs": {
    "enabled": true,
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 15.0,
    "copy_on_select": true,
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": [],
      },
    },
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 80,
          "lint": {
            "extendSelect": ["I"],
          },
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["!ty", "basedpyright", "ruff", "!pyright"],
    },
  },
  "theme": {
    "mode": "dark",
    "light": "Zen Fixed Light",
    "dark": "Monokai-og",
  },
  "indent_guides": {
    "enabled": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "vim_mode": true,
  "buffer_font_size": 17.0,
  "vim": {
    "use_system_clipboard": "never",
  },
  "autosave": "on_focus_change",
  "cursor_blink": false,
  "relative_line_numbers": "disabled",
}
