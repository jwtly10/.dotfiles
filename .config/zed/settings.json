{
  "agent_servers": {
    "github-copilot": {
      "type": "registry"
    }
  },
  "agent": {
    "favorite_models": [],
    "model_parameters": [],
    "use_modifier_to_send": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "unnecessary_code_fade": 0.3,
  "agent_ui_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "scrollbar": {
    "axes": {
      "horizontal": false,
    },
  },
  "icon_theme": "Zed (Default)",
  "load_direnv": "direct",
  "format_on_save": "on",
  "preview_tabs": {
    "enabled": true,
  },
  "terminal": {
    "font_size": 12.0,
    "copy_on_select": true,
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": [],
      },
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true,
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "theme": "One Dark",
  "indent_guides": {
    "enabled": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "vim": {
    "use_system_clipboard": "never",
  },
  "autosave": "on_focus_change",
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
}
